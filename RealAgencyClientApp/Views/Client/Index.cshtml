@page
@model IndexModel
@{
    ViewData["Title"] = "Clients";
}

<h1>Clients</h1>

<table class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model.Clients)
        {
            <tr>
                <td>@client.Id</td>
                <td>@client.Name</td>
                <td>@client.Role</td>
            </tr>
        }
    </tbody>
</table>